{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tokon Tech Log",
  "version": "0.1.0",
  "identifier": "com.tokontech.techlog",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": "trunk build --release",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tokon Tech Log",
        "width": 480,
        "height": 780,
        "minWidth": 340,
        "minHeight": 400,
        "alwaysOnTop": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
